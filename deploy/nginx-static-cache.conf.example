# Include inside the server { } block that serves reviewvera.com public/
# Long-lived cache for versioned static assets (images, CSS, JS, fonts).

location ~* \.(?:ico|css|js|gif|jpe?g|png|webp|svg|woff2?|ttf|eot)$ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
    try_files $uri =404;
}
